# Node.js muhit o‘zgaruvchilari orqali sozlanadi. .env avtomatik o‘qilmaydi.
PORT=3000
HOST=127.0.0.1
# Faqat bazani birinchi yaratishda ishlatiladi; kamida 12 belgi.
# ADMIN_PASSWORD=bu-yerga-uzun-maxfiy-parol
# HTTPS hostingda aniq sayt manzilini kiriting va secure cookie yoqing.
# APP_ORIGIN=https://fond.example.com
# COOKIE_SECURE=true
# Doimiy saqlanadigan katalog; standart: .data
# DATA_DIR=/persistent/11-b-fond
